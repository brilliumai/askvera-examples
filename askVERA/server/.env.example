# Base URL of your AskVERA API deployment
ASKVERA_BASE_URL=https://your-api.example.com

# OAuth 2.0 Client Credentials
# Create these by calling POST /api/askvera/v1/oauth/clients with your x-api-key
ASKVERA_CLIENT_ID=your-client-id-uuid
ASKVERA_CLIENT_SECRET=your-client-secret

# Server port (default: 3001)
PORT=3001

# React dev server origin — update if your front-end runs elsewhere
ALLOWED_ORIGIN=http://localhost:5173
