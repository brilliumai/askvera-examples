# AskVERA Partner Integration - Environment Variables
# Copy this file to .env and fill in your credentials.

# Your OAuth client credentials (provided by AskVera)
ASKVERA_CLIENT_ID=your-client-id-here
ASKVERA_CLIENT_SECRET=your-client-secret-here

# AskVERA API base URL
ASKVERA_API_URL=https://api.askvera.ai

# Local server port
PORT=3100
